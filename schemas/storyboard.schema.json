{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kinetic Editorial Reel Storyboard",
  "type": "object",
  "required": ["version", "format", "script", "scenes"],
  "properties": {
    "version": {"type": "string"},
    "format": {"type": "object", "required": ["width", "height", "fps"], "properties": {"width": {"type": "integer", "const": 1080}, "height": {"type": "integer", "const": 1920}, "fps": {"type": "integer", "minimum": 24, "maximum": 60}}},
    "script": {"type": "string", "minLength": 1},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "start", "duration", "text"], "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "start": {"type": "number", "minimum": 0}, "duration": {"type": "number", "exclusiveMinimum": 0}, "text": {"type": "string"}, "emphasis": {"type": "array", "items": {"type": "string"}}, "visual": {"type": "string"}, "transition": {"type": "string"}, "asset": {"type": ["string", "null"]}}}}
  }
}